#!/usr/bin/env bash
# Strip Cursor Agent branding from commit messages (brand policy).
set -euo pipefail

msg_file="${1:?commit-msg hook requires path to commit message file}"

if [[ ! -f "$msg_file" ]]; then
  echo "commit-msg: message file not found: $msg_file" >&2
  exit 1
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Remove forbidden trailers (case-insensitive line match). Portable (no GNU sed -i).
grep -Ev \
  -e '^[Cc]o-[Aa]uthored-[Bb]y:[[:space:]]*([Cc]ursor[[:space:]]+[Aa]gent|[[:space:]]*<cursoragent@cursor\.com>|.*cursoragent@cursor\.com)' \
  -e '^[Mm]ade-with:[[:space:]]*[Cc]ursor[[:space:]]*$' \
  -e '^[Mm]ade-with:[[:space:]]*[Cc]ursor[[:space:]]*<' \
  "$msg_file" >"$tmp" || true

if ! cmp -s "$msg_file" "$tmp"; then
  mv "$tmp" "$msg_file"
  trap - EXIT
  echo "commit-msg: removed Cursor Agent / Made-with: Cursor trailer(s) from commit message." >&2
else
  rm -f "$tmp"
  trap - EXIT
fi

exit 0
